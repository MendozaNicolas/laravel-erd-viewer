{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "sourceMap": true,
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node"
  },
  "include": [
    "src/extension/**/*",
    "src/shared/**/*",
    "src/core/**/*",
    "test/**/*"
  ],
  "exclude": [
    "src/webview/**/*",
    "node_modules",
    "dist",
    "dist-webview"
  ]
}
